{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nexus: dev",
      "type": "shell",
      "command": "npm run dev",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(Ready in|started server).*"
        }
      }
    },
    {
      "label": "Nexus: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Nexus: lint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Nexus: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Nexus: verify all",
      "dependsOrder": "sequence",
      "dependsOn": ["Nexus: typecheck", "Nexus: lint", "Nexus: build"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
